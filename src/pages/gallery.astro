---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.vue';
import site from '../../content/site.json';
---
<Base title="Gallery" description="Photos of the Segar Cobra on Sri Lankan roads.">
  <section class="section">
    <span class="eyebrow">Gallery</span>
    <h1 class="display">On Sri Lankan roads.</h1>
    <div class="wrap"><Gallery client:load photos={site.gallery} label="Segar Cobra photo viewer" /></div>
  </section>
  <section class="section" id="documents">
    <h2 class="heading">Documents</h2>
    <p class="muted">Pages from the owner's guide and the 2023 NERDC technical evaluation report.</p>
    <div class="wrap"><Gallery client:visible photos={site.guides} label="Documents viewer" /></div>
  </section>
</Base>

<style>
  .wrap { margin-top: 32px; }
  #documents { padding-top: 0; }
</style>
