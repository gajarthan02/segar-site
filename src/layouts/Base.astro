---
import '../styles/tokens.css';
import MenuDrawer from '../components/MenuDrawer.vue';
import site from '../../content/site.json';
import { nav, footer } from '../nav';

interface Props {
  title?: string;
  description?: string;
  /** Transparent white header over a dark full-bleed hero. */
  overlayHeader?: boolean;
}
const { title, description = site.intro, overlayHeader = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.brand}` : `${site.brand} | ${site.car}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/img/hero-wide.jpg" />
    <link rel="icon" href="/img/logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class:list={['site-header', { overlay: overlayHeader }]}>
      <MenuDrawer client:idle items={nav} brand={site.brand} />
      <a class="wordmark" href="/" aria-label={`${site.brand} home`}>SEGAR</a>
      <div class="icons">
        <a href="/gallery/" aria-label="Gallery" class="icon-btn">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="10" r="1.6" /><path d="M21 16l-5-5-8 8" />
          </svg>
        </a>
        <a href="/contact/" aria-label="Contact" class="icon-btn">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
            <path d="M4 6h16v12H4z" /><path d="M4 7l8 6 8-6" />
          </svg>
        </a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="cols">
        {footer.map((col) => (
          <nav aria-label={col.title}>
            <h2>{col.title}</h2>
            <ul>{col.links.map((l) => <li><a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{l.label}</a></li>)}</ul>
          </nav>
        ))}
      </div>
      <div class="base">
        <span class="brand"><img src="/img/logo.jpg" alt="" width="28" height="28" /> © {new Date().getFullYear()} {site.brand}</span>
        <span class="muted">Designed and built in Sri Lanka. Inspired by classic 1960s roadsters; not affiliated with any other car maker.</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 16px; top: 16px; z-index: 100; background: var(--surface); padding: 8px 12px; }
  .site-header {
    position: relative; z-index: 10; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding: 20px var(--gutter); color: var(--text); background: var(--bg); border-bottom: 1px solid var(--border);
  }
  .site-header.overlay { position: absolute; inset: 0 0 auto 0; color: #fff; background: transparent; border-bottom: 0; padding-top: 24px; }
  .wordmark { font-size: clamp(1.1rem, 2.4vw, 1.7rem); letter-spacing: 0.45em; padding-left: 0.45em; text-decoration: none; font-weight: 500; }
  .icons { display: flex; justify-content: flex-end; gap: 8px; }
  .icon-btn { display: inline-flex; padding: 6px; border-radius: var(--radius-s); }
  .icon-btn:hover { background: color-mix(in srgb, currentColor 14%, transparent); }
  .site-footer { padding: 56px var(--gutter) 32px; border-top: 1px solid var(--border); background: var(--surface); }
  .cols { display: grid; gap: 32px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); }
  .cols h2 { font-size: 0.875rem; font-weight: 600; margin: 0 0 12px; }
  .cols ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .cols a { text-decoration: none; color: var(--text-muted); }
  .cols a:hover { color: var(--text); }
  .base { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--border); font-size: 0.8125rem; }
  .brand { display: inline-flex; align-items: center; gap: 10px; }
  .brand img { border-radius: 50%; }
</style>
